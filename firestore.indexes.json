{
  "//indexes-doc": "Sprint 5 — paginated APIs added in services rely on the indexes below. Firestore auto-creates single-field indexes (e.g. students.fullName ASC, storeProducts.name ASC); only composite indexes need to be declared here. TODO: if `StudentService.getAllPaginated` is invoked with both `status` filter AND ordering by `fullName`, Firestore will need a composite index — declare it on first runtime warning: `students` (status ASC, fullName ASC). Likewise, `StoreService.getProductsPaginated` with `activeOnly: true` will need `storeProducts` (active ASC, name ASC). Both are NOT critical until those flows are wired into UI.",
  "//retencao-doc": "Fundação de retenção (REPAGINADA §2/§10): o range por `date` em academies/{aid}/attendance do job diário computeRetentionDaily usa o índice single-field AUTOMÁTICO de `date` — attendance NÃO tem fieldOverride/exemption neste arquivo (verificado 2026-07), então nada a declarar; não criar exemption em attendance sem repor o índice de `date`. Compostos novos: students (status, statusChangedAt) p/ churn consumado do mês; retentionContacts (outcome, at) p/ o job fechar outcomes pending; fieldOverride students.linkedUserId p/ streakRiskCheck via collectionGroup.",
  "indexes": [
    {
      "collectionGroup": "physicalAssessments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Jornal da Academia (student feed): EventService.listPublished filters isPublished==true ordered by startDate ASC.",
      "collectionGroup": "events",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublished", "order": "ASCENDING" },
        { "fieldPath": "startDate", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "syllabus",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "sport", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "workoutExecutions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "exerciseName", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "classId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "competitionPhotos",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "competitionId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Gamificacao (marcos): idempotencia das CFs de streak/ranking — query-before-create por (studentId + autoKey) em academies/{id}/achievements garante que cada marco e criado uma unica vez.",
      "collectionGroup": "achievements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "autoKey", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Gamificacao (marcos): filtros admin por aluno + tipo (ex.: listar so milestone/competition de um aluno) sem ler todos os achievements.",
      "collectionGroup": "achievements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "financials",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dueDate", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "financials",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "financials",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "linkCodes",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "code", "order": "ASCENDING" },
        { "fieldPath": "usedAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "instructorLinkCodes",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "code", "order": "ASCENDING" },
        { "fieldPath": "usedAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "read", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "storeOrders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "storeOrders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "walletTransactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "financialId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "walletTransactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Reserva de aula (A1): promocao da fila — cancelClassReservation busca o proximo waitlist por (occId + status==waitlist) ordenado por waitlistSeq ASC.",
      "collectionGroup": "classBookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "occId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "waitlistSeq", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Reserva de aula (A1): limite por aluno — reserveClassSlot conta reservas ativas futuras por (studentId + status in [confirmed,waitlist] + slotStart>=agora).",
      "collectionGroup": "classBookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "slotStart", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Trocação (C1): histórico de sessões do aluno — getByStudent por (studentId + date DESC).",
      "collectionGroup": "strikingSessions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Trocação (C3): cartel do aluno — getByStudent por (studentId + date DESC).",
      "collectionGroup": "fightRecords",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Trocação (C2): biblioteca de combinações por modalidade — getBySport (sport + order ASC).",
      "collectionGroup": "combos",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "sport", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Social Feed (Fase 1): feed de PARCEIROS — whereIn(authorUid, chunk) + hiddenByAuthor==false orderBy occurredAt desc. Requerido por FeedPostsService.feedForAudience.",
      "collectionGroup": "feedPosts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorUid", "order": "ASCENDING" },
        { "fieldPath": "hiddenByAuthor", "order": "ASCENDING" },
        { "fieldPath": "occurredAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Social Feed (Fase 1): feed de ACADEMIA — where(academyId) + hiddenByAuthor==false orderBy occurredAt desc. Requerido por FeedPostsService.feedForAcademy.",
      "collectionGroup": "feedPosts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "academyId", "order": "ASCENDING" },
        { "fieldPath": "hiddenByAuthor", "order": "ASCENDING" },
        { "fieldPath": "occurredAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Oss recíproco (PESQUISA §2.1/P2): myRecentLikersProvider (oss_providers.dart) lê quem me deu oss — where(authorUid==uid) + orderBy(createdAt desc) na coleção top-level likes; igualdade + orderBy em campo distinto exige composto.",
      "collectionGroup": "likes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Retenção (§2.3): churn consumado do mês — computeRetentionDaily conta transições por (status in [inactive,transferred]) + range em statusChangedAt.",
      "collectionGroup": "students",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "statusChangedAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Retenção (§3.2): fechamento de outcomes — o job diário busca contatos (outcome=='pending') com corte/ordem em `at` (igualdade + range em campos distintos exige composto).",
      "collectionGroup": "retentionContacts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "outcome", "order": "ASCENDING" },
        { "fieldPath": "at", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "//": "Retenção (§9.1): streakRiskCheck varre alunos com conta vinculada via collectionGroup('students').where('linkedUserId','!=',null) — single-field automático só cobre COLLECTION, então o override habilita COLLECTION_GROUP. ATENÇÃO: override SUBSTITUI o auto-index do campo — COLLECTION ASC precisa ficar listado p/ as queries por academia existentes (student_service.dart:53, index.js:553); nada ordena linkedUserId DESC (equality e != funcionam no ASC).",
      "collectionGroup": "students",
      "fieldPath": "linkedUserId",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    },
    {
      "collectionGroup": "walletTransactions",
      "fieldPath": "abacatePayTransactionId",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    },
    {
      "collectionGroup": "walletTransactions",
      "fieldPath": "externalId",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    },
    {
      "collectionGroup": "walletTransactions",
      "fieldPath": "financialId",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    }
  ]
}
