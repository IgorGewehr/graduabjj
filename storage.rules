rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helpers — mirrors firestore.rules role model via
    // userAcademyMapping/{uid}.academyDetails.{academyId}.role
    // ============================================================

    function authed() {
      return request.auth != null;
    }

    function academyRole(academyId) {
      return firestore.get(
        /databases/(default)/documents/userAcademyMapping/$(request.auth.uid)
      ).data.academyDetails[academyId].role;
    }

    function isAdmin(academyId) {
      return authed() && academyRole(academyId) == 'admin';
    }

    function isStaff(academyId) {
      return authed() && (
        academyRole(academyId) == 'admin' ||
        academyRole(academyId) == 'instructor'
      );
    }

    // ============================================================
    // Academy files — public read, role-gated write
    // ============================================================

    // Logo da academia — só admin altera a identidade visual
    match /academies/{academyId}/logo.png {
      allow read: if true;
      allow write: if isAdmin(academyId);
      allow delete: if isAdmin(academyId);
    }

    // Fotos de perfil dos alunos — admin ou instrutor
    match /academies/{academyId}/students/{studentId}/profile.jpg {
      allow read: if true;
      allow write: if isStaff(academyId);
      allow delete: if isStaff(academyId);
    }

    // Fotos de campeonatos — admin ou instrutor
    match /academies/{academyId}/competitions/{competitionId}/photos/{photoId} {
      allow read: if true;
      allow write: if isStaff(academyId);
      allow delete: if isStaff(academyId);
    }

    // Imagens de eventos e notícias — admin ou instrutor
    match /academies/{academyId}/events/{file=**} {
      allow read: if true;
      allow write: if isStaff(academyId);
      allow delete: if isStaff(academyId);
    }

    match /academies/{academyId}/news/{file=**} {
      allow read: if true;
      allow write: if isStaff(academyId);
      allow delete: if isStaff(academyId);
    }

    // Imagens de produtos da loja — só admin gerencia o catálogo
    match /academies/{academyId}/products/{filename} {
      allow read: if true;
      allow write: if isAdmin(academyId);
      allow delete: if isAdmin(academyId);
    }

    // Conteúdo de treino (vídeos e docs) — até 300 MB, staff
    match /academies/{academyId}/content/{file=**} {
      allow read: if true;
      allow write: if isStaff(academyId)
                   && (request.resource == null
                       || request.resource.size < 300 * 1024 * 1024);
      allow delete: if isStaff(academyId);
    }

    // Fallback: qualquer outro arquivo dentro de academies — admin escreve, leitura pública
    match /academies/{academyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin(academyId);
      allow delete: if isAdmin(academyId);
    }

    // Nega tudo fora de academies
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
