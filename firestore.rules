rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Global Helper Functions
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get user document from root users collection
    // Used only for root /users rules and legacy fallback
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get user-academy mapping (primary source of role and academy membership)
    function getUserAcademyMapping() {
      return get(/databases/$(database)/documents/userAcademyMapping/$(request.auth.uid)).data;
    }

    // Get academy-scoped user document (secondary source of role and studentId)
    function getAcademyUserData(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)/users/$(request.auth.uid)).data;
    }

    // Check if academy-scoped user document exists (prevents errors in fallback paths)
    function academyUserExists(academyId) {
      return exists(/databases/$(database)/documents/academies/$(academyId)/users/$(request.auth.uid));
    }

    // Check if user belongs to a specific academy (via mapping)
    function belongsToAcademy(academyId) {
      let mapping = getUserAcademyMapping();
      return isAuthenticated() && (
        academyId in mapping.academyIds ||
        mapping.primaryAcademyId == academyId
      );
    }

    // Associação ARQUIVADA: o aluno saiu/foi transferido desta academia. Ele
    // MANTÉM o id em academyIds (leitura do histórico continua via
    // belongsToAcademy), mas NÃO pode mais ESCREVER (nova presença, check-in,
    // bump de contador, editar a própria ficha) — é somente-leitura.
    function isArchivedMember(academyId) {
      let mapping = getUserAcademyMapping();
      return mapping.keys().hasAll(['academyDetails']) &&
        mapping.academyDetails.keys().hasAll([academyId]) &&
        mapping.academyDetails[academyId].keys().hasAll(['status']) &&
        mapping.academyDetails[academyId].status == 'archived';
    }

    // Check if user is admin of the academy
    // Sources: userAcademyMapping.academyDetails (primary) > academyUser doc (fallback)
    function isAcademyAdmin(academyId) {
      let mapping = getUserAcademyMapping();
      return belongsToAcademy(academyId) && (
        // Primary: from userAcademyMapping.academyDetails
        (mapping.keys().hasAll(['academyDetails']) &&
         mapping.academyDetails.keys().hasAll([academyId]) &&
         mapping.academyDetails[academyId].role == 'admin') ||
        // Fallback: from academy-scoped user doc (only if doc exists)
        (academyUserExists(academyId) && getAcademyUserData(academyId).role == 'admin')
      );
    }

    // Check if user is instructor of the academy (legacy role - kept for backward compatibility)
    // All staff should now use 'admin' role
    function isAcademyInstructor(academyId) {
      let mapping = getUserAcademyMapping();
      return belongsToAcademy(academyId) && (
        (mapping.keys().hasAll(['academyDetails']) &&
         mapping.academyDetails.keys().hasAll([academyId]) &&
         mapping.academyDetails[academyId].role == 'instructor') ||
        // Fallback: from academy-scoped user doc (only if doc exists)
        (academyUserExists(academyId) && getAcademyUserData(academyId).role == 'instructor')
      );
    }

    // Check if user is staff (admin or instructor) of the academy
    // Staff role is standardized as 'admin'; instructor kept as legacy fallback
    function isAcademyStaff(academyId) {
      return isAcademyAdmin(academyId) || isAcademyInstructor(academyId);
    }

    // Get user's studentId for a given academy
    // Sources: userAcademyMapping.academyDetails (primary) > academyUser doc (fallback)
    function isOwnStudent(academyId, studentId) {
      let mapping = getUserAcademyMapping();
      return belongsToAcademy(academyId) && (
        // Primary: from userAcademyMapping.academyDetails
        (mapping.keys().hasAll(['academyDetails']) &&
         mapping.academyDetails.keys().hasAll([academyId]) &&
         mapping.academyDetails[academyId].studentId == studentId) ||
        // Fallback: from academy-scoped user doc (only if doc exists)
        (academyUserExists(academyId) &&
         getAcademyUserData(academyId).keys().hasAll(['studentId']) &&
         getAcademyUserData(academyId).studentId == studentId)
      );
    }

    // Check if a document's studentId matches the current user's studentId
    function isOwnStudentRecord(academyId, docStudentId) {
      let mapping = getUserAcademyMapping();
      return belongsToAcademy(academyId) && (
        // Primary: from userAcademyMapping.academyDetails
        (mapping.keys().hasAll(['academyDetails']) &&
         mapping.academyDetails.keys().hasAll([academyId]) &&
         docStudentId == mapping.academyDetails[academyId].studentId) ||
        // Fallback: from academy-scoped user doc (only if doc exists)
        (academyUserExists(academyId) &&
         getAcademyUserData(academyId).keys().hasAll(['studentId']) &&
         docStudentId == getAcademyUserData(academyId).studentId)
      );
    }

    // Check if the caller's studentId (from the mapping) is in a list of ids.
    // Used by workout plans assigned to specific students.
    function isAssignedStudent(academyId, ids) {
      let mapping = getUserAcademyMapping();
      return belongsToAcademy(academyId)
        && mapping.keys().hasAll(['academyDetails'])
        && mapping.academyDetails.keys().hasAll([academyId])
        && mapping.academyDetails[academyId].studentId in ids;
    }

    // Check if the caller is the responsible adult for [docStudentId]
    // (kids -> adult linking). The student doc stores responsibleUserId = the
    // adult's auth uid; lets a responsible read/pay their dependents' data.
    function isResponsibleForStudent(academyId, docStudentId) {
      return belongsToAcademy(academyId)
        && exists(/databases/$(database)/documents/academies/$(academyId)/students/$(docStudentId))
        && get(/databases/$(database)/documents/academies/$(academyId)/students/$(docStudentId)).data.get('responsibleUserId', null) == request.auth.uid;
    }

    // Check if user is the owner of the academy
    function isAcademyOwner(academyId) {
      let academy = get(/databases/$(database)/documents/academies/$(academyId)).data;
      return isAuthenticated() && academy.ownerId == request.auth.uid;
    }

    // Check if user is a monitor of the academy
    // Monitors are students with additional permissions (chamada + alunos)
    function isMonitor(academyId) {
      let academy = get(/databases/$(database)/documents/academies/$(academyId)).data;
      let mapping = getUserAcademyMapping();
      return belongsToAcademy(academyId)
             && academy.monitorIds != null
             && (
               // Primary: from userAcademyMapping.academyDetails
               (mapping.keys().hasAll(['academyDetails']) &&
                mapping.academyDetails.keys().hasAll([academyId]) &&
                mapping.academyDetails[academyId].studentId != null &&
                mapping.academyDetails[academyId].studentId in academy.monitorIds) ||
               // Fallback: from academy-scoped user doc (only if doc exists)
               (academyUserExists(academyId) &&
                getAcademyUserData(academyId).keys().hasAll(['studentId']) &&
                getAcademyUserData(academyId).studentId != null &&
                getAcademyUserData(academyId).studentId in academy.monitorIds)
             );
    }

    // Check if user is staff OR monitor of the academy
    function isStaffOrMonitor(academyId) {
      return isAcademyStaff(academyId) || isMonitor(academyId);
    }

    // Check if instructor has a specific extra permission granted by the admin
    function hasExtraPermission(academyId, permission) {
      let mapping = getUserAcademyMapping();
      return mapping.keys().hasAll(['academyDetails'])
          && mapping.academyDetails.keys().hasAll([academyId])
          && mapping.academyDetails[academyId].keys().hasAll(['extraPermissions'])
          && permission in mapping.academyDetails[academyId].extraPermissions;
    }

    // Helper: get current user's studentId for this academy (for inline use)
    // Returns studentId from mapping or academy user doc
    function getUserStudentIdFromMapping(academyId) {
      let mapping = getUserAcademyMapping();
      return mapping.keys().hasAll(['academyDetails']) &&
             mapping.academyDetails.keys().hasAll([academyId])
             ? mapping.academyDetails[academyId].studentId
             : null;
    }

    // Validate amount is positive
    function isPositiveAmount(amount) {
      return amount is number && amount > 0;
    }

    // ============================================================================
    // SUBSCRIPTION GATE (audit finding C) — DESIGN ONLY, *** DISABLED ***
    // ============================================================================
    // GOAL: when an academy's subscription lapses (not paid, no courtesy override,
    // trial expired), staff should be blocked from WRITING new data (read stays
    // open so they can see/export their history; the app already shows a paywall).
    //
    // The subscription block lives at academies/{academyId}.subscription and is
    // written ONLY by the payment webhook via the Admin SDK (see the academies
    // update rule, which forbids clients from touching `subscription`). Shape
    // (from lib/models/academy.dart AcademySubscription.toMap):
    //   subscription.paidUntil    : Timestamp | null   (paid access valid until)
    //   subscription.freeOverride : bool               (manual courtesy access)
    //   subscription.trialEndsAt  : Timestamp | null   (explicit trial end)
    // Trial anchor in the app is academy.createdAt + trialDays; rules can't read
    // AppConstants.trialDays, so the gate below relies on the persisted
    // trialEndsAt only (acceptable: a lapsed academy has trialEndsAt in the past).
    //
    // *** DO NOT ENABLE WITHOUT A BACKFILL/AUDIT PASS. *** Wrongly enabling this
    // could instantly lock out paying academies whose `subscription.paidUntil`
    // (or freeOverride/trialEndsAt) isn't correctly populated in prod. This MUST
    // be reviewed and data-verified before turning on. See needsReview.
    //
    // function hasActiveSubscription(academyId) {
    //   let sub = get(/databases/$(database)/documents/academies/$(academyId)).data.get('subscription', {});
    //   return sub.get('freeOverride', false) == true
    //       || (sub.get('paidUntil', null) != null && sub.paidUntil > request.time)
    //       || (sub.get('trialEndsAt', null) != null && sub.trialEndsAt > request.time);
    // }
    //
    // WHEN ENABLING, AND it into the STAFF WRITE rules below (NOT into reads, and
    // NOT into student self-service writes). Exact targets:
    //   - classes        write   -> && hasActiveSubscription(academyId)
    //   - attendance     write   -> && hasActiveSubscription(academyId)
    //   - plans          write   -> && hasActiveSubscription(academyId)
    //   - financials     create  -> && hasActiveSubscription(academyId)
    //   - storeProducts  create/update -> && hasActiveSubscription(academyId)
    //   - storeOrders    update  -> && hasActiveSubscription(academyId)
    //   - competitions   create/update/delete -> && hasActiveSubscription(academyId)
    //   - competitionResults create/update/delete (staff branch only) -> && hasActiveSubscription(academyId)
    //   - beltProgressions write -> && hasActiveSubscription(academyId)
    //   - students       create/update (staff branches) -> && hasActiveSubscription(academyId)
    // Leave student-owned writes (self check-in, own orders/enrollments, workout
    // logs) UNGATED so a paid-up academy's lapse doesn't break student UX mid-cycle.
    // ============================================================================

    // ============================================
    // Root Users Collection
    // ============================================
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Users can create their own document during registration
      // Allow admin role ONLY if creating during academy creation (new user)
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && (
                      // Student registration (no role or role == student)
                      (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'student')
                      ||
                      // Admin registration during academy creation
                      (request.resource.data.role == 'admin' && request.resource.data.isActive == true)
                    );

      // Users can update non-sensitive fields
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'academyId']);

      // Users can delete their own document during account deletion
      allow delete: if isAuthenticated() && request.auth.uid == userId;

      // FCM Tokens subcollection
      match /fcmTokens/{tokenId} {
        // User can manage their own tokens
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // ============================================
      // B2C lutador — Diário de Rolagem (training logs) + rolls.
      // Dado PESSOAL do lutador (nasce da pessoa, não da academia). O dono
      // cria/lê/edita os próprios; agregados derivados ficam em /stats (CF-only).
      // ============================================
      match /training_logs/{logId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create, update, delete:
          if isAuthenticated() && request.auth.uid == userId;
      }
      match /rolls/{rollId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create, update, delete:
          if isAuthenticated() && request.auth.uid == userId;
      }
      // Agregados materializados (streak/horas/marcos) — só a Cloud Function
      // (Admin SDK) escreve; o dono apenas lê.
      match /stats/{statId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ============================================
    // B2C lutador — Espelho público PERSON-LEVEL (fighterProfiles) e de academia
    // (academyProfiles). ADITIVO: NÃO substitui academies/{id}/publicProfiles
    // (mantido p/ ranking intra-academia). PII-free, escrito SÓ por Cloud Function
    // (Admin SDK) via allowlist única. Leitura: pública se discoverable, ou o dono.
    // ============================================
    match /fighterProfiles/{userId} {
      // Perfil PÚBLICO PII-free do lutador (nome, faixa, stats) — qualquer
      // logado lê (descoberta + amigos cross-academy). O DONO escreve o próprio
      // espelho (client-side mirror; v1 do sistema de amigos).
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Grafo de amizade (seguir). Doc-id = "{followerUid}_{targetUid}".
    match /follows/{followId} {
      allow read: if isAuthenticated()
                  && (resource.data.followerUid == request.auth.uid
                      || resource.data.targetUid == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.followerUid == request.auth.uid
                    && request.resource.data.followerUid
                       != request.resource.data.targetUid;
      allow delete: if isAuthenticated()
                    && resource.data.followerUid == request.auth.uid;
    }
    match /academyProfiles/{academyId} {
      allow read: if true; // perfil público da academia (PII-free)
      allow write: if false; // só Admin SDK/CF
    }

    // ============================================
    // Feed Social — feedPosts (materializado pelo dono) e likes.
    // ============================================

    // feedPosts/{postId}: coleção top-level materializada pelo próprio autor
    // (v1, owner-driven). O postId é DETERMINÍSTICO por marco — ver FeedPost.dart.
    //
    // Invariantes de segurança:
    //  - create: só o próprio autor, com hiddenByAuthor==false gravado (filtro
    //    server-side depende deste campo presente em todo doc).
    //  - update: só o autor, e SÓ os campos hiddenByAuthor/hiddenAt (ocultar).
    //    A regra usa hasOnly para impedir qualquer outro campo — incluindo likeCount,
    //    que é mantido por CF onLikeWrite (v2) e não forjável pelo cliente.
    //  - delete: nunca (post determinístico ressurgiria no próximo mirror()).
    //
    // Quando CF-produz (v2): trocar create para `if false` (Admin SDK dispensa regra).
    match /feedPosts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.hiddenByAuthor == false
        // academyId (se presente) tem que ser UMA das academias do autor —
        // senão qualquer um injetaria post no feed ACADEMIA de terceiros.
        && (request.resource.data.academyId == null
            || request.resource.data.academyId in getUserAcademyMapping().academyIds);

      allow update: if isAuthenticated() && (
        // 1) O AUTOR oculta o próprio post (hiddenByAuthor/hiddenAt).
        (resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hiddenByAuthor', 'hiddenAt']))
        ||
        // 2) MODERAÇÃO: o STAFF (admin/professor) da academia do post pode
        //    ocultar/reexibir (hiddenByStaff) e editar o texto (staffHeadline).
        //    Restrito aos campos de moderação — não pode forjar likeCount, autor
        //    ou payload. academyId precisa existir e ser a academia do staff.
        (resource.data.academyId != null
          && isAcademyStaff(resource.data.academyId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hiddenByStaff', 'hiddenByStaffAt', 'staffHeadline']))
      );

      allow delete: if false;
    }

    // likes/{postId}_{likerUid}: reusa 1:1 o molde de follows.
    // Doc-id composto → anti-spam (1 like por par). Self-like bloqueado
    // client-side (FeedPostsService.like) e aqui (likerUid != authorUid).
    match /likes/{likeId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.likerUid == request.auth.uid
        && request.resource.data.likerUid != request.resource.data.authorUid
        && likeId == request.resource.data.postId + '_' + request.resource.data.likerUid;

      // Idempotência: like() usa .set() — um re-like no mesmo doc é update.
      // Só o próprio liker, e likerUid imutável (não vira like de outro).
      allow update: if isAuthenticated()
        && resource.data.likerUid == request.auth.uid
        && request.resource.data.likerUid == resource.data.likerUid;

      allow delete: if isAuthenticated()
        && resource.data.likerUid == request.auth.uid;
    }

    // ============================================
    // User-Academy Mapping
    // ============================================
    match /userAcademyMapping/{userId} {
      // Users can read their own mapping
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // SECURITY: Three create patterns, role elevation requires verifiable ownership.
      // 1. Empty mapping during normal signup (no academies)
      // 2. Admin during own-academy creation - verified via academies/{id}.ownerId == self
      // 3. Student joining via link code - role MUST be 'student' in academyDetails
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && (
                      // Pattern 1: Empty mapping
                      (request.resource.data.academyIds.size() == 0)
                      ||
                      // Pattern 2: Owner of single academy claiming admin
                      (request.resource.data.academyIds.size() == 1
                       && request.resource.data.primaryAcademyId == request.resource.data.academyIds[0]
                       && exists(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0]))
                       && get(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])).data.ownerId == request.auth.uid)
                      ||
                      // Pattern 3: Single-academy student via link code.
                      // SECURITY: the asserted studentId must reference an UNCLAIMED
                      // student record (linkedUserId null, or already this caller), so
                      // a user cannot self-declare membership against an arbitrary or
                      // already-linked studentId to read PII / hijack the record. The
                      // legit client writes this mapping BEFORE stamping
                      // students/{id}.linkedUserId, so the record is still orphan here.
                      (request.resource.data.academyIds.size() == 1
                       && request.resource.data.primaryAcademyId == request.resource.data.academyIds[0]
                       && request.resource.data.keys().hasAll(['academyDetails'])
                       && request.resource.data.academyDetails[request.resource.data.academyIds[0]].role == 'student'
                       && exists(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])/students/$(request.resource.data.academyDetails[request.resource.data.academyIds[0]].studentId))
                       && (
                         get(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])/students/$(request.resource.data.academyDetails[request.resource.data.academyIds[0]].studentId)).data.get('linkedUserId', null) == null
                         || get(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])/students/$(request.resource.data.academyDetails[request.resource.data.academyIds[0]].studentId)).data.get('linkedUserId', null) == request.auth.uid
                       ))
                    );

      // SECURITY: Role elevation cannot happen via client write. Update patterns:
      // A. Update non-role metadata only (primaryAcademyId, updatedAt, sync fields)
      // B. Shrink academyDetails (leaving an academy)
      // C. First-time student join: mapping was empty, adding exactly one academy as student.
      //    This covers the createAccountWithLinkCode flow which creates an empty mapping
      //    via createGlobalUser() and then calls linkUserToAcademy() client-side.
      // D. Academy creation by the owner: mapping was empty, adding exactly one academy
      //    as admin, AND that academy's ownerId == self. createGlobalUser() pre-creates
      //    an empty mapping, so the academy-creation flow reaches linkUserToAcademy() as
      //    an UPDATE — create Pattern 2 never fires. Ownership is verified the same way
      //    Pattern 2 does, so role elevation is gated on a verifiable fact (academy
      //    ownership), not a client-asserted role.
      // Adding a 2nd+ academy and instructor elevation must still go through a Cloud Function.
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && (
                      // Path A: no academyDetails change
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['academyDetails'])
                      ||
                      // Path B: shrinking - removing an academy entry
                      (request.resource.data.academyDetails.size() < resource.data.academyDetails.size()
                       && resource.data.academyDetails.keys().hasAll(request.resource.data.academyDetails.keys()))
                      ||
                      // Path C: first student join from an empty mapping (role 'student').
                      // SECURITY: same UNCLAIMED-student binding as create Pattern 3 —
                      // the asserted studentId must reference an orphan (or own) record.
                      (resource.data.academyDetails.size() == 0
                       && request.resource.data.academyIds.size() == 1
                       && request.resource.data.academyDetails.size() == 1
                       && request.resource.data.academyDetails[request.resource.data.academyIds[0]].role == 'student'
                       && exists(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])/students/$(request.resource.data.academyDetails[request.resource.data.academyIds[0]].studentId))
                       && (
                         get(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])/students/$(request.resource.data.academyDetails[request.resource.data.academyIds[0]].studentId)).data.get('linkedUserId', null) == null
                         || get(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])/students/$(request.resource.data.academyDetails[request.resource.data.academyIds[0]].studentId)).data.get('linkedUserId', null) == request.auth.uid
                       ))
                      ||
                      // Path D: owner promoting their own freshly-created academy to admin
                      (resource.data.academyDetails.size() == 0
                       && request.resource.data.academyIds.size() == 1
                       && request.resource.data.academyDetails.size() == 1
                       && request.resource.data.primaryAcademyId == request.resource.data.academyIds[0]
                       && request.resource.data.academyDetails[request.resource.data.academyIds[0]].role == 'admin'
                       && exists(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0]))
                       && get(/databases/$(database)/documents/academies/$(request.resource.data.academyIds[0])).data.ownerId == request.auth.uid)
                    );

      // Users can delete their own mapping during account deletion
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // Academies Collection
    // ============================================
    match /academies/{academyId} {
      // Anyone who belongs to the academy can read academy info
      allow read: if belongsToAcademy(academyId);

      // Owner or admin can update academy settings.
      // `subscription` is server-only (written by the payment webhook via the
      // Admin SDK) so a client can't self-grant access (paidUntil/freeOverride).
      // REVERTIDO (deploy com app ANTIGO vivo): `mpConnected` fica FORA das chaves
      // bloqueadas. O settings_screen do app antigo salva o doc de configurações
      // inteiro (set merge) e um mpConnected divergente entraria em affectedKeys,
      // bloqueando TODO o save de configurações. Re-endurecer (mpConnected
      // server-only) só DEPOIS que o app novo estiver publicado na Apple.
      allow update: if (isAcademyOwner(academyId) || isAcademyAdmin(academyId))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['ownerId', 'createdAt', 'subscription']);

      // Allow academy creation - user must be setting themselves as owner
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name.size() >= 3;

      // Never allow delete from client
      allow delete: if false;

      // ============================================
      // Users Subcollection (Academy-scoped users)
      // ============================================
      match /users/{userId} {
        // Staff can read all academy users
        allow read: if isAcademyStaff(academyId);

        // Users can read their own document
        allow read: if isAuthenticated() && request.auth.uid == userId;

        // Allow user to create their own document, gated on a VERIFIABLE fact —
        // never a client-asserted role/studentId:
        // - Admin: caller must OWN the academy (academies/{id}.ownerId == self).
        //   The academy-creation flow writes academies/{id} (ownerId=self) BEFORE
        //   this doc, so the legit owner passes; a stranger cannot self-insert as
        //   admin of someone else's academy (privilege-escalation / takeover).
        // - Student: caller must already belong (mapping) AND the studentId must
        //   match the studentId recorded in their OWN mapping for this academy, so
        //   this doc cannot inject an arbitrary studentId into the fallback branch
        //   of isOwnStudent() and hijack another student's record.
        allow create: if isAuthenticated()
                      && request.auth.uid == userId
                      && (
                        (request.resource.data.role == 'admin'
                         && exists(/databases/$(database)/documents/academies/$(academyId))
                         && get(/databases/$(database)/documents/academies/$(academyId)).data.ownerId == request.auth.uid)
                        ||
                        (request.resource.data.role == 'student'
                         && belongsToAcademy(academyId)
                         && (
                           !('studentId' in request.resource.data)
                           || (getUserAcademyMapping().academyDetails.keys().hasAll([academyId])
                               && request.resource.data.studentId == getUserAcademyMapping().academyDetails[academyId].studentId)
                         ))
                      );

        // Staff can update users (except sensitive fields)
        allow update: if isAcademyStaff(academyId)
                      && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['createdAt']);

        // Never allow delete from client
        allow delete: if false;
      }

      // ============================================
      // Students Subcollection
      // ============================================
      match /students/{studentId} {
        // Staff can read all students
        allow read: if isAcademyStaff(academyId);

        // Monitors can read all students (UI filters financial fields)
        allow read: if isMonitor(academyId);

        // Students can read their own record
        allow read: if isOwnStudent(academyId, studentId);

        // Responsible adult can read their dependents' record (kids -> adult)
        allow read: if belongsToAcademy(academyId)
                    && resource.data.get('responsibleUserId', null) == request.auth.uid;

        // PRIVACIDADE (auditoria de perfil): REMOVIDO o read público do doc bruto
        // do aluno (`isProfilePublic == true`). Ele expunha TODA a PII (nome, CPF,
        // telefone, nascimento, etc.) a QUALQUER um, anulando o design do espelho.
        // O acesso público agora é SÓ via academies/{id}/publicProfiles/{id}
        // (espelho sem PII, sincronizado por CF), que o app e o ranking já leem.
        // Membros/staff/dono continuam lendo o doc completo pelas regras acima.

        // Staff can create/delete students
        allow create, delete: if isAcademyStaff(academyId);

        // Monitors can create students (without financial fields)
        allow create: if isMonitor(academyId)
                      && !request.resource.data.keys().hasAny(['tuitionValue', 'tuitionDay', 'planId']);

        // Staff can update all fields
        allow update: if isAcademyStaff(academyId);

        // Monitors can update students (except financial and sensitive fields).
        // responsibleUserId/* gate the kids->adult payer access, so only staff
        // (admins) may set them — never a monitor (a student-level role).
        allow update: if isMonitor(academyId)
                      && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['tuitionValue', 'tuitionDay', 'planId',
                                   'currentBelt', 'currentStripes', 'status',
                                   'beltHistory', 'createdAt', 'createdBy',
                                   'responsibleUserId', 'responsibleStudentId',
                                   'responsibleName']);

        // Students can update only personal info (including photoUrl and registration linking fields) or soft-delete their own record
        allow update: if isOwnStudent(academyId, studentId)
                      && !isArchivedMember(academyId)
                      && (
                        // Normal update of personal info
                        (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['photoUrl', 'updatedAt', 'linkedUserId', 'email', 'cpf', 'phone',
                                    'nickname', 'birthDate', 'rg', 'weight',
                                    'address', 'bloodType', 'allergies', 'healthNotes',
                                    'emergencyContact', 'isProfilePublic',
                                    // Athlete-managed modalities: the student may set which
                                    // sports they train (`sports`) and their primary one
                                    // (`primarySport`). The VERIFIED grade ceiling lives in
                                    // `sportData` (staff/promotion-only, NOT listed here), so
                                    // self-declared sports get no ceiling while academy-seeded
                                    // sports stay capped by self_graduation_guard.js.
                                    'sports', 'primarySport'])
                         // SECURITY: linkedUserId may only be CLAIMED on an orphan
                         // record (or re-affirmed by the same user) — never re-pointed
                         // away from an already-linked account.
                         && (
                           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedUserId'])
                           || resource.data.get('linkedUserId', null) == null
                           || resource.data.get('linkedUserId', null) == request.auth.uid
                         ))
                        ||
                        // Soft delete during account deletion
                        (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'deletedAt', 'deletedByUser'])
                         && request.resource.data.status == 'deleted'
                         && request.resource.data.deletedByUser == true)
                      );

        // QR self-check-in counter sync: a student bumps their own
        // attendanceCount by exactly +1, paired with the matching attendance
        // doc created under the attendance `create` rule below. +1-only so the
        // counter (which feeds attendance-based graduation) cannot be inflated
        // in a single write. NOTE: client-side QR check-in cannot cryptographically
        // prove the student scanned a live QR; this matches both apps' current
        // design. A server-validated QR Cloud Function would harden it further.
        allow update: if isOwnStudent(academyId, studentId)
                      && !isArchivedMember(academyId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['attendanceCount', 'updatedAt'])
                      && request.resource.data.attendanceCount is number
                      && request.resource.data.attendanceCount ==
                           (resource.data.attendanceCount is number ? resource.data.attendanceCount : 0) + 1;

        // Timeline subcollection
        match /timeline/{eventId} {
          allow read: if isStaffOrMonitor(academyId) || isOwnStudent(academyId, studentId);
          allow write: if isAcademyStaff(academyId);
        }

        // ============================================
        // Self-declared graduations (JORNADA multi-esporte, F2b)
        // ============================================
        // O aluno registra a SUA propria progressao auto-declarada (ex.: faixa
        // ganha em outra academia / esporte sem federacao). NAO e o TETO
        // verificado: o aluno NUNCA escreve em beltProgressions (:1097-1103),
        // que continua server/staff-authoritative. Estas entradas sao sempre
        // source=="self" e o campo `source` e IMUTAVEL no update.
        match /selfGraduations/{gradId} {
          allow read: if isAuthenticated();
          allow create: if isOwnStudentRecord(academyId, studentId)
                        && request.resource.data.source == 'self';
          allow update: if isOwnStudentRecord(academyId, studentId)
                        && request.resource.data.source == resource.data.source
                        && resource.data.source == 'self';
          allow delete: if isOwnStudentRecord(academyId, studentId)
                        && resource.data.source == 'self';
        }

        // ============================================
        // Self-declared competitions (JORNADA multi-esporte, F2b)
        // ============================================
        // Resultados de competicao auto-declarados pelo aluno. Mesmo contrato
        // das selfGraduations: source=="self" obrigatorio e imutavel. NAO
        // alimenta beltProgressions nem o TETO verificado.
        match /selfCompetitions/{compId} {
          allow read: if isAuthenticated();
          allow create: if isOwnStudentRecord(academyId, studentId)
                        && request.resource.data.source == 'self';
          allow update: if isOwnStudentRecord(academyId, studentId)
                        && request.resource.data.source == resource.data.source
                        && resource.data.source == 'self';
          allow delete: if isOwnStudentRecord(academyId, studentId)
                        && resource.data.source == 'self';
        }
      }

      // ============================================
      // Public Profiles Mirror (Sprint R)
      // ============================================
      // Privacy-correct, slim projection of a student doc (NO PII) kept in sync
      // by the mirrorStudentPublicProfile Cloud Function. Ranking + the public
      // fighter profile read THIS instead of the PII-laden student doc.
      // Any academy member may read peers' mirror; non-members (public site)
      // only when the student opted in (isProfilePublic == true).
      // Writable ONLY by the Admin SDK / Cloud Function (never the client).
      match /publicProfiles/{studentId} {
        allow read: if belongsToAcademy(academyId)
                    || resource.data.isProfilePublic == true;
        allow write: if false;
      }

      // ============================================
      // Classes Subcollection
      // ============================================
      match /classes/{classId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Attendance Subcollection
      // ============================================
      match /attendance/{attendanceId} {
        // Staff and monitors can read all attendance
        allow read: if isStaffOrMonitor(academyId);

        // Students can read their own attendance
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);

        // GRANULAR PERMISSION (audit finding): admins and monitors always take
        // attendance; legacy instructors need the grantable 'attendance:take'
        // permission. This still permits a manual presence write with an arbitrary
        // classId (e.g. 'aula_particular') by an admin/monitor — the rule gates on
        // the WRITER's role, not on the classId — so the aula-particular feature is
        // unaffected. The student self-check-in branch below is independent.
        allow write: if isAcademyAdmin(academyId)
                     || isMonitor(academyId)
                     || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'attendance:take'));

        // QR self-check-in: an authenticated student creates their OWN
        // attendance doc (paired with the +1 attendanceCount bump on their
        // student doc). Guards:
        //   - studentId is the caller's own student record in this academy
        //   - verifiedBy == auth uid (record traceable to who wrote it)
        //   - enrolled in the target class, OR the class is "open" (no roster)
        //   - weight, if present, is a positive number
        // Update/delete stay staff-only — a student can mark present but cannot
        // rewrite or remove attendance history.
        allow create: if isAuthenticated()
          && isOwnStudentRecord(academyId, request.resource.data.studentId)
          && !isArchivedMember(academyId)
          && request.resource.data.verifiedBy == request.auth.uid
          && (
               // Skip the roster check if the class doc is missing (deleted /
               // synthetic id) so a valid self-check-in is never denied by a
               // failed get(); enrolled in the class; or the class is "open".
               !exists(/databases/$(database)/documents/academies/$(academyId)/classes/$(request.resource.data.classId))
               || !get(/databases/$(database)/documents/academies/$(academyId)/classes/$(request.resource.data.classId)).data.keys().hasAny(['studentIds'])
               || get(/databases/$(database)/documents/academies/$(academyId)/classes/$(request.resource.data.classId)).data.studentIds.size() == 0
               || request.resource.data.studentId in get(/databases/$(database)/documents/academies/$(academyId)/classes/$(request.resource.data.classId)).data.studentIds
             )
          && (
               !request.resource.data.keys().hasAny(['weight'])
               || (request.resource.data.weight is number && request.resource.data.weight > 0)
             );
      }

      // ============================================
      // Check-ins (student-requested presence, confirmed by staff)
      // ============================================
      // graduabjj's "student check-in" writes here first (status 'pending');
      // staff later confirm → AttendanceService.markPresent. Had no rule before,
      // so every student check-in fell through to deny-all and was rejected.
      match /checkins/{checkinId} {
        // Staff and monitors manage check-ins (list, confirm, delete).
        allow read, write: if isStaffOrMonitor(academyId);

        // Students read their own check-ins.
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);

        // Students create their own pending check-in.
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId)
                      && !isArchivedMember(academyId)
                      && request.resource.data.status == 'pending';

        // Students can cancel their own check-in.
        allow delete: if isOwnStudentRecord(academyId, resource.data.studentId)
                      && !isArchivedMember(academyId);
      }

      // ============================================
      // Plans Subcollection
      // ============================================
      match /plans/{planId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyAdmin(academyId);
      }

      // ============================================
      // Instructor Link Codes Subcollection
      // ============================================
      match /instructorLinkCodes/{codeId} {
        // Staff can read all codes (managing invites)
        allow read: if isAcademyStaff(academyId);

        // Anyone authenticated can read UNUSED codes (collectionGroup validation)
        allow read: if resource.data.usedAt == null;

        // Only admins can create codes (they carry grantable extraPermissions,
        // so an instructor must not be able to mint privilege escalations).
        allow create: if isAcademyAdmin(academyId);

        // Staff can delete codes
        allow delete: if isAcademyStaff(academyId);

        // App ANTIGO (em produção, pré-aprovação Apple) ainda marca usedAt
        // client-side no cadastro com código de instrutor — manter o update
        // permitido (restrito a usedAt/usedBy[/Name] do próprio usuário). Re-
        // endurecer para server-only (DoS de queima cross-academy) só DEPOIS que
        // o app novo (que usa a CF redeemInstructorCode) estiver publicado.
        allow update: if isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['usedAt', 'usedBy', 'usedByName'])
                      && request.resource.data.usedBy == request.auth.uid;
      }

      // ============================================
      // Link Codes Subcollection
      // ============================================
      match /linkCodes/{codeId} {
        // Staff can read all codes
        allow read: if isAcademyStaff(academyId);

        // Students can read codes from their academy
        allow read: if belongsToAcademy(academyId);

        // CRITICAL: Allow unauthenticated users to read UNUSED codes
        // This is necessary for account registration with link codes
        // Users can query via collectionGroup to find their code across all academies
        allow read: if resource.data.usedAt == null;

        // Staff and monitors can create/delete codes.
        allow write: if isStaffOrMonitor(academyId);

        // App ANTIGO (em produção) marca usedAt client-side no cadastro com
        // código de aluno (LinkCodeService.markAsUsed) — manter permitido
        // (restrito a usedAt/usedBy do próprio usuário). Re-endurecer para
        // server-only (DoS de queima cross-academy) só DEPOIS que o app novo
        // (que usa a CF joinAcademy) estiver publicado na Apple.
        allow update: if isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['usedAt', 'usedBy'])
                      && request.resource.data.usedBy == request.auth.uid;
      }

      // ============================================
      // Financials Subcollection (CRITICAL - Payment Data)
      // ============================================
      match /financials/{financialId} {
        // Staff can read all financials
        allow read: if isAcademyStaff(academyId);

        // Students can read their own financials
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);

        // Responsible adult can read their dependents' financials (kids -> adult)
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);

        // GRANULAR PERMISSION (audit finding): admins always create; instructors
        // need the grantable 'financial:create' permission. Update/delete remain
        // ADMIN-ONLY below (no grantable edit/delete exists, so escalation via an
        // instructor grant is impossible).
        allow create: if (isAcademyAdmin(academyId)
                          || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'financial:create')))
                      && request.resource.data.academyId == academyId
                      && isPositiveAmount(request.resource.data.amount);

        // Staff can update financials, but:
        //  - Cannot touch payment-gateway audit fields
        //  - TERMINAL-STATE IMMUTABILITY (audit finding E): once a record reaches a
        //    SETTLED-MONEY terminal status (paid/refunded/chargeback), its status,
        //    amount and payment fields are FROZEN. This stops the app's "Marcar como
        //    pago" button from reverting a refunded/chargeback doc back to 'paid'.
        //    Legitimate pending->paid transitions are unaffected (resource.data.status
        //    is still 'pending' at that point). 'cancelled' is intentionally NOT
        //    frozen here: it is an UNPAID administrative state with a documented
        //    re-activation path (PaymentService.reactivate -> cancelled => pending/
        //    overdue); freezing it would break that staff workflow. The server
        //    (Admin SDK) bypasses these rules and remains the only writer that can
        //    move money between settled states (e.g. paid -> refunded via a webhook).
        allow update: if isAcademyStaff(academyId)
                      && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['paidViaAbacatePay', 'abacatePayTransactionId'])
                      && !(
                        (resource.data.status == 'paid'
                         || resource.data.status == 'refunded'
                         || resource.data.status == 'chargeback')
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['status', 'amount', 'paymentDate', 'paidAt', 'method'])
                      );

        // Staff can delete only records that have not settled money (a
        // paid/refunded/chargeback record is permanent history). An unpaid
        // 'cancelled' charge stays deletable, matching the pre-audit behaviour.
        allow delete: if isAcademyStaff(academyId)
                      && resource.data.status != 'paid'
                      && resource.data.status != 'refunded'
                      && resource.data.status != 'chargeback';
      }

      // ============================================
      // Recurring subscriptions (Mercado Pago Preapproval)
      // ============================================
      // Read-only for the client: staff see all; a student sees their own
      // (drives the "Minha assinatura" card). ALL writes are server-only — the
      // backend (createMpSubscription / webhook / cancel) is the single writer,
      // so the MP preapproval and the doc never diverge.
      match /subscriptions/{subscriptionId} {
        allow read: if isAcademyStaff(academyId)
                    || isOwnStudentRecord(academyId, resource.data.studentId)
                    || isResponsibleForStudent(academyId, resource.data.studentId);
        allow write: if false;
      }

      // ============================================
      // Wallet Subcollection (CRITICAL - Money)
      // ============================================
      match /wallet/{docId} {
        // Owner and admins can read wallet
        allow read: if isAcademyOwner(academyId) || isAcademyAdmin(academyId);

        // NEVER allow client writes - only via Cloud Functions/webhooks
        allow write: if false;
      }

      // ============================================
      // Private server-only store (Mercado Pago OAuth tokens, etc.)
      // CRITICAL: holds the admin's MP access/refresh tokens — clients must
      // NEVER read or write. Only Cloud Functions (Admin SDK) touch it.
      // ============================================
      match /private/{docId} {
        allow read: if false;
        allow write: if false;
      }

      // ============================================
      // Wallet Transactions (CRITICAL - Money)
      // ============================================
      match /walletTransactions/{transactionId} {
        // Owner and admins can read transactions
        allow read: if isAcademyOwner(academyId) || isAcademyAdmin(academyId);

        // NEVER allow client writes - only via Cloud Functions/webhooks
        allow write: if false;
      }

      // ============================================
      // Store Products Subcollection
      // ============================================
      match /storeProducts/{productId} {
        // Anyone in academy can read products
        allow read: if belongsToAcademy(academyId);

        // Only staff can manage products
        allow create, update: if isAcademyStaff(academyId)
                              && request.resource.data.academyId == academyId
                              && isPositiveAmount(request.resource.data.price);

        allow delete: if isAcademyStaff(academyId);
      }

      // ============================================
      // Store Orders Subcollection (CRITICAL)
      // ============================================
      match /storeOrders/{orderId} {
        // Staff can read all orders
        allow read: if isAcademyStaff(academyId);

        // Students can read their own orders (via mapping or academy user doc)
        allow read: if belongsToAcademy(academyId)
                    && isOwnStudentRecord(academyId, resource.data.studentId);

        // Students can create orders for themselves (via mapping or academy user doc)
        // FIELD-WHITELIST NA CRIACAO (auditoria MP, achado low): o cliente NAO pode
        // semear campos de pagamento/auditoria no pedido recem-criado. Sem isso, o
        // reuse-guard do PIX (createMpOrderPixPayment) leria pixCode/gatewayPaymentId/
        // pixAmount/pixExpiresAt plantados e devolveria um QR forjado (auto-sabotagem
        // do checkout). Proibimos esses campos por nome — abordagem retrocompativel
        // com o app antigo, que so grava os campos legitimos do pedido.
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId)
                      && request.resource.data.academyId == academyId
                      && request.resource.data.status == 'pending_payment'
                      && isPositiveAmount(request.resource.data.total)
                      && !request.resource.data.keys().hasAny([
                           'gatewayPaymentId', 'externalPaymentId',
                           'abacatePayTransactionId', 'pixCode', 'pixAmount',
                           'pixExpiresAt', 'stockSettled', 'paidAt'
                         ]);

        // Staff can update order status as it moves through fulfillment
        // (pending_payment -> paid -> preparing -> ready -> delivered), but:
        //  - Payment/audit fields are always frozen on the client.
        //  - TERMINAL-STATE IMMUTABILITY (audit finding E): once an order is in a
        //    terminal/closed status (delivered/cancelled, plus refunded/chargeback
        //    should they ever appear), its `status` is FROZEN — a closed order can
        //    no longer be re-opened or flipped to another status from the client.
        //    The legitimate forward fulfillment flow stays open because those
        //    intermediate states are not terminal. Server (Admin SDK) bypasses
        //    these rules and can still record refunds/chargebacks.
        allow update: if isAcademyStaff(academyId)
                      && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['abacatePayTransactionId', 'paidAt', 'total', 'items'])
                      && !(
                        (resource.data.status == 'delivered'
                         || resource.data.status == 'cancelled'
                         || resource.data.status == 'refunded'
                         || resource.data.status == 'chargeback')
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['status'])
                      );

        // Staff can cancel unpaid orders only (a paid/fulfilled/closed order is
        // permanent history and cannot be hard-deleted from the client).
        allow delete: if isAcademyStaff(academyId)
                      && resource.data.status == 'pending_payment';
      }

      // ============================================
      // Events (academy members + public-facing site)
      // ============================================
      match /events/{eventId} {
        // Published items are world-readable for the public site (marcusjj);
        // academy members read everything; staff manage.
        allow read: if (resource.data.isPublished == true) || belongsToAcademy(academyId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Controle de acesso (catraca) — Arquitetura C (push-cloud)
      // accessEvents/deviceRateLimits são escritos SÓ pela Cloud Function
      // ingestAccessEvent (o Admin SDK ignora estas rules). O cliente (kiosk/
      // totem, rodando como conta staff da academia) apenas LÊ os eventos.
      // devices guarda o segredo HMAC → admin-only (nunca exposto a aluno).
      // ============================================
      match /accessEvents/{eventId} {
        allow read: if isAcademyStaff(academyId);
        allow write: if false; // só a Cloud Function (Admin SDK)
      }
      match /devices/{deviceId} {
        // Config da catraca (vendor, secret HMAC, userMap). O secret é sensível
        // → restrito ao admin.
        allow read, write: if isAcademyAdmin(academyId);
      }
      match /deviceRateLimits/{rlId} {
        allow read, write: if false; // só a Cloud Function (Admin SDK)
      }

      // ============================================
      // News (public-facing site content — marcusjj)
      // ============================================
      match /news/{newsId} {
        // Published items are public; staff can always read drafts
        allow read: if resource.data.isPublished == true;
        allow read: if isAcademyStaff(academyId);
        allow create, update, delete: if isAcademyStaff(academyId);
      }

      // ============================================
      // Public-facing institutional info (sibling site read target — marcusjj)
      // Staff mirror non-sensitive academy fields here so the main
      // /academies/{id} doc (Asaas keys, KYC, subscription) stays closed to
      // anonymous reads.
      // ============================================
      match /public/{docId} {
        allow read: if true;
        allow create, update, delete: if isAcademyStaff(academyId);
      }

      // ============================================
      // Competitions Subcollection
      // ============================================
      match /competitions/{competitionId} {
        allow read: if belongsToAcademy(academyId);
        // Public read: team competition schedule (public site)
        allow read: if true;
        // GRANULAR PERMISSION (audit finding): admins always manage competitions;
        // legacy instructors need the grantable 'competitions:create' permission.
        allow create, delete: if isAcademyAdmin(academyId)
                              || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'competitions:create'));
        allow update: if isAcademyAdmin(academyId)
                      || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'competitions:create'));

        // Students can update only enrolledStudentIds (self-enroll/unenroll from legacy array)
        allow update: if belongsToAcademy(academyId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['enrolledStudentIds', 'updatedAt']);
      }

      // ============================================
      // Competition Enrollments
      // ============================================
      match /competitionEnrollments/{enrollmentId} {
        allow read: if belongsToAcademy(academyId);
        // Public read: team roster transparency (public site)
        allow read: if true;
        allow write: if isAcademyStaff(academyId);

        // Students can enroll themselves (via mapping or academy user doc)
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId);

        // Students can update their own enrollment (category, weight, transport)
        allow update: if isOwnStudentRecord(academyId, resource.data.studentId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['ageCategory', 'weightCategory', 'transportPreference', 'updatedAt']);

        // Students can cancel their own enrollment
        allow delete: if isOwnStudentRecord(academyId, resource.data.studentId);
      }

      // ============================================
      // Competition Results
      // ============================================
      match /competitionResults/{resultId} {
        allow read: if belongsToAcademy(academyId);
        // Public read: medals/results are public team info (public site)
        allow read: if true;
        // GRANULAR PERMISSION (audit finding): admins manage all results; legacy
        // instructors need the grantable 'competitions:create' permission. The
        // self-record allowance (a student creating/updating their OWN result) is
        // preserved unchanged.
        allow create: if isAcademyAdmin(academyId)
          || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'competitions:create'))
          || (belongsToAcademy(academyId) && isOwnStudentRecord(academyId, request.resource.data.studentId));
        allow update: if isAcademyAdmin(academyId)
          || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'competitions:create'))
          || (belongsToAcademy(academyId) && isOwnStudentRecord(academyId, resource.data.studentId));
        allow delete: if isAcademyAdmin(academyId)
          || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'competitions:create'));
      }

      // ============================================
      // Competition Photos
      // ============================================
      match /competitionPhotos/{photoId} {
        // Anyone in the academy can read photos
        allow read: if belongsToAcademy(academyId);
        // Public read: competition gallery is public (public site)
        allow read: if true;

        // Admins can create unlimited, students can create own photos
        // Enrollment check is enforced at the application level
        allow create: if isAuthenticated()
                      && belongsToAcademy(academyId)
                      && request.resource.data.studentId != null
                      && request.resource.data.url != null
                      && request.resource.data.competitionId != null
                      && request.resource.data.storagePath != null
                      && (request.resource.data.caption == null || request.resource.data.caption.size() <= 200)
                      && (
                        // Admin can upload unlimited
                        isAcademyStaff(academyId) ||
                        // Student can upload own photos
                        isOwnStudentRecord(academyId, request.resource.data.studentId)
                      );

        // Can update own photos (caption only) or admin can update any
        allow update: if isAuthenticated()
                      && belongsToAcademy(academyId)
                      && (
                        // Admin can update any field
                        isAcademyStaff(academyId) ||
                        // Student can only update own photo's caption
                        (resource.data.createdBy == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'updatedAt']) &&
                         (request.resource.data.caption == null || request.resource.data.caption.size() <= 200))
                      );

        // Can delete own photos or admin can delete any
        allow delete: if isAuthenticated()
                      && belongsToAcademy(academyId)
                      && (isAcademyStaff(academyId) || resource.data.createdBy == request.auth.uid);
      }

      // ============================================
      // Achievements
      // ============================================
      match /achievements/{achievementId} {
        allow read: if isAcademyStaff(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        // Sprint R: any academy member can read peers' achievements for the
        // public-profile timeline. Achievements hold graduation + medal history
        // (non-PII); financials/assessments/skillProgress stay locked.
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyStaff(academyId);

        // Students can create their OWN achievements, but ONLY competition results
        // (anti-fraud de gamificacao). Marcos de graduacao/faixa (graduation/stripe),
        // pagamento (stripe), e contadores server-authoritative
        // (milestone/attendanceStreak/rankingPosition/trainingPr) so podem ser
        // criados por staff (allow write na linha 805) ou pelas Cloud Functions.
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId)
                      && request.resource.data.type == 'competition';
      }

      // ============================================
      // Belt Progressions
      // ============================================
      match /beltProgressions/{progressionId} {
        allow read: if isAcademyStaff(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        // Admins always can graduate; instructors need graduation:manage permission
        allow write: if isAcademyAdmin(academyId)
                     || (isAcademyInstructor(academyId) && hasExtraPermission(academyId, 'graduation:manage'));
      }

      // ============================================
      // Assessments (Kids)
      // ============================================
      match /assessments/{assessmentId} {
        allow read: if isAcademyStaff(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        // Responsible adult can read their dependents' assessments (kids -> adult),
        // mirroring the financials grant above.
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Physical / anthropometric assessments (medidas, % gordura, fotos).
      // Distinta da avaliacao tecnica 1-5 acima. Staff escreve; aluno le a sua;
      // responsavel le a dos dependentes.
      // ============================================
      match /physicalAssessments/{assessmentId} {
        allow read: if isAcademyStaff(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Syllabus / curriculo de tecnicas por faixa (graduacao pedagogica).
      // Nao e sensivel: qualquer membro da academia le; staff escreve.
      // ============================================
      match /syllabus/{techniqueId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Skill progress: dominio/feedback por tecnica de cada aluno.
      // Staff escreve; aluno le o seu; responsavel le o dos dependentes.
      // ============================================
      match /skillProgress/{progressId} {
        allow read: if isAcademyStaff(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Catalogo de exercicios (A5) — staff escreve; qualquer membro le.
      // Nao e sensivel.
      // ============================================
      match /exercises/{exerciseId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Registro de execucao de treino (A6) — o aluno escreve/le os seus;
      // staff le (acompanhar). Espelha workoutLogs.
      // ============================================
      match /workoutExecutions/{execId} {
        allow read: if isAcademyStaff(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId);
        allow update, delete: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, resource.data.studentId);
      }

      // ============================================
      // Reserva de aula (A1) — capacidade + fila SERVER-AUTHORITATIVE.
      // TODA escrita acontece nas Cloud Functions (reserveClassSlot /
      // cancelClassReservation) via Admin SDK, que IGNORA estas regras. O
      // cliente nunca escreve a vaga -> contador impossivel de fraudar.
      // ============================================
      match /classOccurrences/{occId} {
        // Qualquer membro le as vagas (X/Y) para montar a tela de reserva.
        allow read: if belongsToAcademy(academyId);
        // Escrita so via callable (Admin SDK). Cliente nao escreve.
        allow write: if false;
      }

      match /classBookings/{bookingId} {
        allow read: if isStaffOrMonitor(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        // Escrita so via callable (Admin SDK). Cliente nao escreve.
        allow write: if false;
      }

      // ============================================
      // Trocação (C1): registro de sessão de trocação — o aluno escreve/le os
      // seus; staff/responsavel le. Espelha workoutExecutions.
      // ============================================
      match /strikingSessions/{sessionId} {
        allow read: if isStaffOrMonitor(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId);
        allow update, delete: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, resource.data.studentId);
      }

      // ============================================
      // Trocação (C3): cartel/ficha de luta — cartel OFICIAL: só staff escreve;
      // aluno/responsavel le o seu. Espelha assessments (avaliacao tecnica).
      // ============================================
      match /fightRecords/{recordId} {
        allow read: if isStaffOrMonitor(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Trocação (C2): biblioteca de combinações — staff escreve; qualquer
      // membro le. Nao e sensivel. Espelha exercises/syllabus.
      // ============================================
      match /combos/{comboId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyStaff(academyId);
      }

      // ============================================
      // Musculação (E2): metas de carga — o aluno escreve/le as suas; staff le.
      // Espelha workoutExecutions.
      // ============================================
      match /strengthGoals/{goalId} {
        allow read: if isStaffOrMonitor(academyId);
        allow read: if isOwnStudentRecord(academyId, resource.data.studentId);
        allow read: if isResponsibleForStudent(academyId, resource.data.studentId);
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId);
        allow update, delete: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, resource.data.studentId);
      }

      // ============================================
      // Notifications
      // ============================================
      match /notifications/{notificationId} {
        // Users can read their own notifications
        allow read: if belongsToAcademy(academyId)
                    && resource.data.userId == request.auth.uid;

        // Users can mark their own notifications as read
        allow update: if belongsToAcademy(academyId)
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

        // Only staff/system can create notifications
        allow create: if isAcademyStaff(academyId);

        // Users can delete their own notifications
        allow delete: if belongsToAcademy(academyId)
                      && resource.data.userId == request.auth.uid;
      }

      // ============================================
      // Billing Contact Log
      // ============================================
      match /billingContactLog/{logId} {
        // Staff can read all contact logs
        allow read: if isAcademyStaff(academyId);

        // Staff can create contact logs (logging billing attempts)
        allow create: if isAcademyStaff(academyId);

        // No updates or deletes from client
        allow update, delete: if false;
      }

      // ============================================
      // Settings
      // ============================================
      match /settings/{settingId} {
        allow read: if belongsToAcademy(academyId);
        allow write: if isAcademyAdmin(academyId);
      }

      // ============================================
      // Workout Plans (structured training — all modalities)
      // ============================================
      // ============================================
      // Mesociclos (E1) — mesmo modelo de audiência de workoutPlans.
      // ============================================
      match /mesocycles/{mesoId} {
        allow read, write: if isAcademyStaff(academyId);
        allow read: if belongsToAcademy(academyId)
                    && (
                      resource.data.audience == 'academy'
                      || resource.data.audience == 'sport'
                      || isAssignedStudent(academyId, resource.data.assignedStudentIds)
                    );
      }

      match /workoutPlans/{planId} {
        // Staff manage everything.
        allow read, write: if isAcademyStaff(academyId);

        // Students read academy-wide and sport-library plans, plus personal
        // plans assigned to them. assignedStudentIds is always present (empty
        // for non-personal plans) so the `in` check is safe. These branches
        // mirror the two queries in WorkoutPlanService.getForStudent so a
        // student's queries only return docs they're allowed to read.
        allow read: if belongsToAcademy(academyId)
                    && (
                      resource.data.audience == 'academy'
                      || resource.data.audience == 'sport'
                      || isAssignedStudent(academyId, resource.data.assignedStudentIds)
                    );
      }

      // ============================================
      // Content — training videos & documents (all modalities)
      // Same targeting model as workoutPlans.
      // ============================================
      match /content/{contentId} {
        // Staff manage everything.
        allow read, write: if isAcademyStaff(academyId);

        // Students read academy-wide / sport-library content, plus items
        // personally assigned to them. Mirrors TrainingVideoService queries.
        allow read: if belongsToAcademy(academyId)
                    && (
                      resource.data.audience == 'academy'
                      || resource.data.audience == 'sport'
                      || isAssignedStudent(academyId, resource.data.assignedStudentIds)
                    );
      }

      // ============================================
      // Workout Logs (student per-day exercise completion)
      // ============================================
      match /workoutLogs/{logId} {
        // Staff can read for progress; students read their own.
        allow read: if isAcademyStaff(academyId)
                    || isOwnStudentRecord(academyId, resource.data.studentId);
        // A student writes only their own log (studentId field must be theirs).
        allow create: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, request.resource.data.studentId);
        allow update: if belongsToAcademy(academyId)
                      && isOwnStudentRecord(academyId, resource.data.studentId);
      }
    }

    // ============================================
    // COLLECTION GROUP QUERIES (Cross-Academy)
    // ============================================

    // Link Codes - Allow reading UNUSED codes across all academies
    // This is required for student registration via link codes
    // Security: Only allows reading codes that haven't been used yet
    match /{path=**}/linkCodes/{codeId} {
      // Allow reading unused codes for registration flow
      // Once a code is used (usedAt != null), it becomes invisible to prevent enumeration
      allow read: if resource.data.usedAt == null;
    }

    // Collection group access to instructor codes (auth required, unused only)
    match /{path=**}/instructorLinkCodes/{codeId} {
      allow read: if isAuthenticated() && resource.data.usedAt == null;
    }

    // ============================================
    // DENY ALL OTHER PATHS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
